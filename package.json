{
  "name": "grammy-docs-bot",
  "version": "1.0.0",
  "description": "A Telegram inline bot that searches the grammY documentation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "telegram",
    "bot",
    "grammy"
  ],
  "author": "KnightNiwrem",
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
